---
layout: layouts/base.njk
---

<article class="post-entry">
  <p class="post-kicker"><a href="{{ '/' | url }}">Back to home</a></p>
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time class="post-date" datetime="{{ page.date | datePath }}">{{ page.date | postDate }}</time>
  </header>

  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
