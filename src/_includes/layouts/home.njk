---
layout: layouts/base.njk
---

<section class="hero">
  {{ content | safe }}
</section>

<section class="post-listing">
  <div class="section-heading">
    <h2>Development log</h2>
    <p>Playable builds and notes, newest first.</p>
  </div>

  {% if collections.posts.length %}
    <ol class="post-list">
      {% for post in collections.posts %}
        <li class="post-card">
          <a class="post-link" href="{{ post.url | url }}">
            <span class="post-title">{{ post.data.title }}</span>
            <time class="post-date" datetime="{{ post.date | datePath }}">{{ post.date | postDate }}</time>
          </a>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No posts yet.</p>
  {% endif %}
</section>
