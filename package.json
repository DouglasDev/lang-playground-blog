{
	"name": "lang-playground-blog",
	"version": "1.0.0",
	"private": true,
	"description": "A blog web site using the Eleventy base blog starter.",
	"type": "module",
	"packageManager": "pnpm@10.12.4",
	"scripts": {
		"prepare": "husky",
		"build": "eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 eleventy",
		"build-ghpages": "eleventy --pathprefix=/lang-playground-blog/",
		"dev": "eleventy --serve --quiet",
		"dev:ghpages": "eleventy --pathprefix=/lang-playground-blog/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* eleventy",
		"format": "prettier . --write --ignore-unknown",
		"format:check": "prettier . --check --ignore-unknown"
	},
	"engines": {
		"node": ">=24"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"luxon": "^3.7.2",
		"prettier": "^3.8.4",
		"prismjs": "^1.30.0",
		"zod": "^4.3.6",
		"zod-validation-error": "^5.0.0"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5"
	}
}
